{
  "name": "teka-rdc",
  "version": "0.0.1",
  "private": true,
  "description": "Teka RDC \u2014 E-commerce marketplace for DR Congo",
  "scripts": {
    "dev:api": "pnpm --filter api dev",
    "dev:buyer-web": "pnpm --filter buyer-web dev",
    "dev:seller-web": "pnpm --filter seller-web dev",
    "dev:admin-web": "pnpm --filter admin-web dev",
    "dev:web": "pnpm --parallel --filter '*-web' dev",
    "build": "pnpm --filter @teka/shared build && pnpm --filter './apps/*' build",
    "lint": "pnpm --recursive lint",
    "type-check": "pnpm --recursive type-check",
    "test": "pnpm --recursive test",
    "db:migrate": "pnpm --filter api prisma:migrate",
    "db:push": "pnpm --filter api prisma:push",
    "db:seed": "pnpm --filter api prisma:seed",
    "db:reset-catalog": "pnpm --filter api prisma:reset-catalog",
    "db:studio": "pnpm --filter api prisma:studio",
    "clean": "pnpm --recursive exec rm -rf node_modules dist .next .turbo"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "uuid": "^11.1.1",
      "multer@<2.2.0": "^2.2.0",
      "form-data@<2.5.6": "^2.5.6",
      "form-data@>=4.0.0 <4.0.6": "^4.0.6",
      "@opentelemetry/core@<2.8.0": "^2.8.0",
      "serialize-javascript@>=5.0.0 <7.0.5": "^7.0.5",
      "path-to-regexp@>=8.0.0 <8.4.0": "^8.4.0",
      "qs@>=6.11.1 <6.16.0": "^6.16.0",
      "body-parser@>=2.0.0 <2.3.0": "^2.3.0",
      "lodash@<4.18.0": "^4.18.0",
      "websocket-driver@<0.7.5": "^0.7.5",
      "file-type@>=13.0.0 <21.3.2": "^21.3.2",
      "dompurify@<3.4.13": "^3.4.13",
      "fflate@>=0.4.5 <0.4.9": "^0.4.9",
      "protobufjs@<7.6.5": "^7.6.5",
      "brace-expansion@<1.1.18": "^1.1.18",
      "brace-expansion@>=3.0.0 <5.0.9": "^5.0.9",
      "js-yaml@>=3.0.0 <3.15.1": "^3.15.1",
      "js-yaml@>=4.0.0 <4.3.1": "^4.3.1",
      "nanoid@<3.3.18": "^3.3.18",
      "postcss@<8.5.23": "^8.5.23",
      "fast-uri@>=3.0.0 <3.1.6": "^3.1.6",
      "browserslist@<4.28.7": "^4.28.7",
      "flatted@<3.4.2": "^3.4.2",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "handlebars@<4.7.9": "^4.7.9",
      "defu@<6.1.5": "^6.1.5",
      "ajv@>=7.0.0-alpha.0 <8.18.0": "^8.18.0",
      "@babel/core@<7.29.6": "^7.29.6",
      "@humanfs/node@<0.16.8": "^0.16.8"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-f88m-g3jw-g9cj",
        "GHSA-38f7-945m-qr2g",
        "GHSA-ggr8-5vv4-36mx"
      ]
    }
  }
}
