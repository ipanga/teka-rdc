# Fastlane — mobile release toolchain for Teka's two apps (iOS + Android).
#
# ONE Fastfile drives BOTH apps (buyer + seller). The app is selected per-run
# via the `TEKA_APP` env var (buyer|seller); everything app-specific lives in
# the APPS map below. Apple credentials never appear here — they arrive as env
# vars set from GitHub Secrets by the workflow.
#
# Lanes (called from .github/workflows/release-mobile-ipa.yml):
#   fastlane ios setup_signing     — install match cert+profile, flip the
#                                    production Release config to Manual signing
#                                    (CI checkout only — never committed).
#   fastlane ios upload_testflight — push a built .ipa to TestFlight via the
#                                    App Store Connect API key.
#
# Lane (called from .github/workflows/release-mobile-aab.yml):
#   fastlane android upload_play   — push a built .aab to a Play TESTING track
#                                    via the Play service account. Never
#                                    production.
#
# The actual `flutter build ipa` / `flutter build appbundle` happens in the
# workflow (not `gym`/`gradle`) so the Flutter `--dart-define`s (flavor config +
# Sentry DSN/release) are preserved. Fastlane's role is narrow: signing assets
# in, store out.

# Per-app configuration. bundle_id/team_id/scheme are non-secret (team ids live
# in the pbxproj too). Production flavor only — TestFlight ships production.
#
# `group_env` / `default_group` drive TestFlight distribution. Uploading alone
# never put a build in front of a tester: until 2026-08-09 this lane uploaded
# and stopped, so every build landed in App Store Connect with an EMPTY Groups
# column — no invite email, invisible in the TestFlight app. See
# `upload_testflight` below for why both `skip_*` flags had to change too.
#
# `package_id` is the ANDROID applicationId — the Play Store's identity for the
# app. It currently equals `bundle_id` for both apps, but they are different
# identifiers in different stores that merely coincide, so it is stated
# separately rather than reused. `play_tracks_test.rb` asserts each one still
# matches the `applicationId` in that app's `android/app/build.gradle.kts`, so
# a Gradle-side rename cannot silently point a release at the wrong listing.
APPS = {
  "buyer" => {
    app_dir:       "apps/buyer-mobile",
    bundle_id:     "com.tootiye.teka",
    package_id:    "com.tootiye.teka",
    team_id:       "YK6Z393A4D",
    group_env:     "TESTFLIGHT_BUYER_GROUP",
    default_group: "Teka Buyer test team",
  },
  "seller" => {
    app_dir:       "apps/seller-mobile",
    bundle_id:     "com.tootiye.tekaseller",
    package_id:    "com.tootiye.tekaseller",
    team_id:       "YK6Z393A4D",
    group_env:     "TESTFLIGHT_SELLER_GROUP",
    default_group: "Testers Teka RDC",
  },
}.freeze

# The single production Release build config produced by scripts/ios-flavorize.rb.
PROD_CONFIG = "Release-production".freeze

def app_key
  key = ENV["TEKA_APP"].to_s
  return key if APPS.key?(key)

  UI.user_error!("TEKA_APP must be 'buyer' or 'seller' (got: #{key.inspect})")
end

def app_config
  APPS.fetch(app_key)
end

# Resolve the internal TestFlight group for the CURRENT app.
#
# The app → env-var-NAME mapping lives in the APPS table above, so the buyer
# lane can only ever read TESTFLIGHT_BUYER_GROUP and the seller lane only
# TESTFLIGHT_SELLER_GROUP. A workflow typo cannot hand one app the other's
# group, because the workflow never chooses the variable name — this does.
#
# The literal default keeps releases working before the repo variables exist;
# an explicit variable always wins so the names can be changed in App Store
# Connect without a code change.
def testflight_group
  key = app_key
  cfg = APPS.fetch(key)

  group = ENV[cfg[:group_env]].to_s.strip
  group = cfg[:default_group] if group.empty?

  UI.user_error!("No TestFlight group resolved for '#{key}'") if group.empty?

  # Belt and braces for the cross-wiring case: if this app somehow resolved a
  # group that belongs to the OTHER app, stop rather than notify the wrong
  # testers. Distribution is not reversible by re-running.
  others = APPS.reject { |k, _| k == key }.values.flat_map do |other|
    [ENV[other[:group_env]].to_s.strip, other[:default_group]]
  end.reject(&:empty?)

  if others.include?(group)
    UI.user_error!(
      "Refusing to distribute the '#{key}' build to '#{group}' — that group " \
      "belongs to another app. Check #{cfg[:group_env]}."
    )
  end

  group
end

# Append a line to the GitHub Actions job summary. No-op locally.
# Only non-secret facts are ever passed in here (app, version, build, group).
def summary(line)
  path = ENV["GITHUB_STEP_SUMMARY"].to_s
  return if path.empty?

  File.open(path, "a") { |f| f.puts(line) }
end

# Configure the App Store Connect API key from the generic ASC_* env vars the
# workflow sets (per-app secrets are selected in the workflow's ternary, so the
# Fastfile stays app-agnostic here). Key content is base64 in ASC_KEY_P8_B64.
def load_asc_api_key
  app_store_connect_api_key(
    key_id:      ENV.fetch("ASC_KEY_ID"),
    issuer_id:   ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_P8_B64"),
    is_key_content_base64: true,
    in_house:    false,
  )
end

require "base64"

platform :ios do
  # Install signing assets and switch the production Release config to Manual
  # signing so `flutter build ipa --export-options-plist` can export an
  # App-Store-signed archive headlessly.
  lane :setup_signing do
    cfg = app_config

    # Ephemeral keychain — auto-created, unlocked, and cleaned up by the runner.
    setup_ci

    # Read-only: clone + decrypt existing cert/profile from teka-ios-certs.
    # git_url + storage/type/readonly come from fastlane/Matchfile.
    match(
      app_identifier: cfg[:bundle_id],
      team_id:        cfg[:team_id],
    )

    # Flip ONLY the production Release config to Manual signing with the match
    # profile. This mutates the working-copy pbxproj in the CI checkout; it is
    # never committed, so local dev keeps CODE_SIGN_STYLE=Automatic.
    update_code_signing_settings(
      path:                  "#{cfg[:app_dir]}/ios/Runner.xcodeproj",
      use_automatic_signing: false,
      targets:               ["Runner"],
      build_configurations:  [PROD_CONFIG],
      bundle_identifier:     cfg[:bundle_id],
      team_id:               cfg[:team_id],
      code_sign_identity:    "Apple Distribution",
      profile_name:          "match AppStore #{cfg[:bundle_id]}",
    )

    UI.success("Signing ready for #{cfg[:bundle_id]} (#{PROD_CONFIG} → Manual)")
  end

  # Upload an already-built .ipa (path in IPA_PATH) to TestFlight. No build
  # here — the workflow's `flutter build ipa` produced the signed archive.
  lane :upload_testflight do
    cfg   = app_config
    key   = app_key
    ipa   = ENV.fetch("IPA_PATH")
    UI.user_error!("IPA not found at #{ipa}") unless File.exist?(ipa)

    group   = testflight_group
    api_key = load_asc_api_key

    version = get_ipa_info_plist_value(ipa: ipa, key: "CFBundleShortVersionString")
    build   = get_ipa_info_plist_value(ipa: ipa, key: "CFBundleVersion")

    UI.message("#{key}: #{cfg[:bundle_id]} #{version} (#{build}) → internal group '#{group}'")

    # INTERNAL distribution. Apple's API does NOT let a build be assigned to an
    # internal group, so this deliberately does not pass `groups:`.
    #
    #   skip_waiting_for_build_processing: false
    #     Fastlane never distributes while this is true — distribution can only
    #     happen once Apple has finished processing. Also required so export
    #     compliance is settled here rather than left for a human.
    #
    #   skip_submission: false
    #     `true` skips the whole distribute step, including the export
    #     compliance handling above.
    #
    #   distribute_external: false + submit_beta_review: false
    #     Internal only, and never submitted for Apple's external Beta App
    #     Review. `submit_beta_review` DEFAULTS TO TRUE in pilot, and pilot
    #     submits whenever `submit_beta_review && (groups || distribute_external)`
    #     — so the 2026-08-09 attempt that passed `groups:` triggered an
    #     external review submission and failed with "Beta App Description is
    #     required to submit a build for external testing". It must be pinned
    #     false explicitly.
    #
    #   no `groups:`
    #     `groups:` makes pilot POST /v1/builds/{id}/relationships/betaGroups,
    #     which Apple rejects for internal groups:
    #       "Builds cannot be assigned to this internal group.
    #        - Cannot add internal group to a build."
    #     There is no API that adds a build to an internal group. Internal
    #     groups receive builds through the group's own "automatic
    #     distribution" setting (hasAccessToAllBuilds) — verified below.
    upload_to_testflight(
      api_key:                           api_key,
      ipa:                               ipa,
      skip_waiting_for_build_processing: false,
      skip_submission:                   false,
      distribute_external:               false,
      submit_beta_review:                false,
    )

    # `upload_to_testflight` raises if the group does not exist or distribution
    # fails, which already fails the job. This reads the assignment back from
    # App Store Connect so a green run means "testers can see it", not merely
    # "the upload returned".
    assigned = verify_group_assignment(cfg[:bundle_id], version, build, group)

    summary("### iOS TestFlight — #{key}")
    summary("")
    summary("| | |")
    summary("|---|---|")
    summary("| Application | `#{cfg[:bundle_id]}` (#{key}) |")
    summary("| Version | #{version} |")
    summary("| Build number | #{build} |")
    summary("| Processing | complete (waited) |")
    summary("| Group | #{group} (internal) |")
    summary("| Distribution | #{assigned ? '✅ assigned' : '⚠️ could not be read back'} |")
    summary("")

    UI.success("#{key} #{version} (#{build}) distributed to '#{group}'")
  end

  # Confirm the build actually reached the internal group.
  #
  # An internal group receives builds ONLY through its own "automatic
  # distribution" setting (`hasAccessToAllBuilds`) — Apple has no API to push a
  # build into an internal group. So the check is: the group exists, it is
  # internal, it is set to receive every build, and our build is listed.
  #
  # Raises on a real distribution failure — testers would not receive it. A
  # failure to QUERY is only a warning: upload and processing have already
  # succeeded by then, and failing a good release because a read-back helper
  # broke would be worse.
  def verify_group_assignment(bundle_id, version, build, expected)
    app = Spaceship::ConnectAPI::App.find(bundle_id)
    group = app.get_beta_groups.find { |g| g.name == expected }

    if group.nil?
      UI.user_error!(
        "Internal TestFlight group '#{expected}' does not exist for #{bundle_id}. " \
        "Nothing was distributed."
      )
    end

    unless group.is_internal_group
      UI.important("'#{expected}' is not an internal group — check the App Store Connect setup")
    end

    unless group.has_access_to_all_builds
      UI.user_error!(
        "Internal group '#{expected}' does not have automatic distribution enabled, " \
        "and Apple provides no API to add a build to an internal group " \
        "(\"Cannot add internal group to a build\"). Enable " \
        "\"Automatically distribute builds to this group\" (hasAccessToAllBuilds) " \
        "on the group in App Store Connect — one-time — or every release will " \
        "need assigning by hand."
      )
    end

    # Match on the build number alone. `Build#version` IS CFBundleVersion, and
    # ours is a Unix timestamp, so it is unique across the whole app — while
    # `Build#app_version` raises unless the query included pre_release_version,
    # which fetch_builds does not guarantee.
    if group.fetch_builds.any? { |b| b.version.to_s == build.to_s }
      UI.success("Verified: #{version} (#{build}) is available to '#{expected}'")
      return true
    end

    # The group is set to take every build, so this is a propagation lag rather
    # than a failed assignment — App Store Connect is the source of truth.
    UI.important(
      "Build #{version} (#{build}) is not listed under '#{expected}' yet, though " \
      "the group takes all builds. Confirm in App Store Connect."
    )
    false
  rescue FastlaneCore::Interface::FastlaneError
    raise # a real distribution failure — keep it fatal
  rescue StandardError => e
    UI.important("Could not verify group availability (#{e.class}): #{e.message}")
    false
  end
end

# ────────────────────────────────────────────────────────────────────────────
# ANDROID — Google Play
# ────────────────────────────────────────────────────────────────────────────

# Tracks this lane is allowed to publish to. `production` is deliberately
# ABSENT, and `resolve_play_track` refuses it explicitly.
#
# Both apps are ALREADY LIVE in Play production. An automated push to that
# track reaches every existing user on auto-update and cannot be recalled —
# Play has no "unrelease". Promotion out of testing stays a deliberate human
# action in the Play Console. The service account is also not granted the
# production permission, so this is the second of two independent locks.
PLAY_TRACKS = %w[internal alpha].freeze
DEFAULT_PLAY_TRACK = "internal".freeze

# Resolve the Play track for this run: PLAY_TRACK, defaulting to internal.
def resolve_play_track
  track = ENV["PLAY_TRACK"].to_s.strip
  track = DEFAULT_PLAY_TRACK if track.empty?

  if track == "production"
    UI.user_error!(
      "Refusing to publish to the 'production' track. Both apps are live; an " \
      "automated production release reaches every user on auto-update and " \
      "cannot be undone. Promote from a testing track in the Play Console."
    )
  end

  unless PLAY_TRACKS.include?(track)
    UI.user_error!("PLAY_TRACK must be one of #{PLAY_TRACKS.join(', ')} (got: #{track.inspect})")
  end

  track
end

# Decode the Play service-account JSON from PLAY_JSON_B64.
#
# Returned as a String and handed straight to `json_key_data:`. It is never
# written to disk, never logged, never put in the job summary, and never
# interpolated into a message — a service-account key can publish to both apps.
def load_play_json_key
  raw = ENV["PLAY_JSON_B64"].to_s.strip
  UI.user_error!("PLAY_JSON_B64 is not set — cannot authenticate to Google Play") if raw.empty?

  decoded = Base64.decode64(raw)
  if decoded.empty? || !decoded.lstrip.start_with?("{")
    # Says what is wrong without echoing any part of the value.
    UI.user_error!("PLAY_JSON_B64 did not decode to JSON — re-encode the service-account key with `base64 -i key.json`")
  end

  decoded
end

platform :android do
  # Upload an already-built .aab (path in AAB_PATH) to a Play TESTING track.
  # No build here — the workflow's `flutter build appbundle` produced the
  # upload-key-signed bundle, and Play App Signing re-signs it on Google's side.
  lane :upload_play do
    cfg   = app_config
    key   = app_key
    aab   = ENV.fetch("AAB_PATH")
    UI.user_error!("AAB not found at #{aab}") unless File.exist?(aab)

    track    = resolve_play_track
    validate = ENV["PLAY_VALIDATE_ONLY"].to_s == "true"

    # R8 minification is ON for both apps' release builds
    # (android/app/build.gradle.kts → isMinifyEnabled = true), so without the
    # mapping file every Play crash report and ANR is an unreadable stack of
    # obfuscated symbols. Optional rather than fatal: a missing mapping is
    # worth a warning, not a failed release.
    mapping = ENV["MAPPING_PATH"].to_s
    mapping = nil if mapping.empty? || !File.exist?(mapping)
    UI.important("No mapping.txt — Play crash reports for this build will stay obfuscated") if mapping.nil?

    UI.message("#{key}: #{cfg[:package_id]} → Play track '#{track}'#{validate ? ' (VALIDATE ONLY)' : ''}")

    upload_to_play_store(
      package_name:   cfg[:package_id],
      aab:            aab,
      track:          track,
      release_status: "completed",
      mapping_paths:  mapping ? [mapping] : nil,
      json_key_data:  load_play_json_key,

      # Dry run: Google validates the edit and discards it. Nothing reaches a
      # tester. Used for the first credential check.
      validate_only:  validate,

      # ── DO NOT REMOVE ANY OF THESE FOUR ────────────────────────────────────
      # `supply` uploads store metadata, images, screenshots and changelogs by
      # DEFAULT, reading them from fastlane/metadata/android. This repo has no
      # such directory — and both apps have real, live, human-written Play
      # listings. Left unpinned, a release would push empty local metadata over
      # the live listing for a production app. These are not tidiness flags;
      # they are the difference between a release and an incident.
      skip_upload_metadata:    true,
      skip_upload_images:      true,
      skip_upload_screenshots: true,
      skip_upload_changelogs:  true,
    )

    version_name, version_code = play_version(cfg)

    summary("### Android Play — #{key}")
    summary("")
    summary("| | |")
    summary("|---|---|")
    summary("| Application | `#{cfg[:package_id]}` (#{key}) |")
    summary("| Version | #{version_name || '(unread)'} (versionCode #{version_code || '?'}) |")
    summary("| Track | #{track} (testing) |")
    summary("| Release status | #{validate ? 'validate-only — nothing published' : 'completed'} |")
    summary("| Store listing | untouched (metadata/images/screenshots/changelogs skipped) |")
    summary("| Mapping file | #{mapping ? '✅ uploaded' : '⚠️ absent — crash reports obfuscated'} |")
    summary("")

    if validate
      UI.success("#{key}: validated against Google Play — nothing was published")
    else
      UI.success("#{key}: #{cfg[:package_id]} uploaded to '#{track}'")
    end
  end

  # versionName + versionCode for the job summary, read from the pubspec the
  # bundle was built from in this same workflow run. No gem, no unzip, nothing
  # that can fail a good release — `flutter build appbundle` derives the
  # Gradle `versionCode`/`versionName` from exactly this line.
  def play_version(cfg)
    pubspec = File.join(cfg[:app_dir], "pubspec.yaml")
    line = File.readlines(pubspec).find { |l| l.start_with?("version:") }
    name, code = line.to_s.sub("version:", "").strip.split("+")
    [name, code]
  rescue StandardError
    [nil, nil]
  end
end
