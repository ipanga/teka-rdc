<?xml version="1.0" encoding="utf-8"?>
<!--
  MS1 — pre-API-31 counterpart of data_extraction_rules.xml. Redundant while
  `allowBackup="false"` is set, and kept so the intent survives if anyone ever
  flips that flag back on.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
