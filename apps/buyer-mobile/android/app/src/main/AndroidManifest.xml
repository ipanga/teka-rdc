<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 13+ runtime notification permission. Requested at runtime
         by firebase_messaging.requestPermission(); older versions
         (< API 33) grant automatically when notifications are first
         posted. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Flutter's built-in deep linking is ON by default since Flutter
                 3.x, which hands the raw incoming URI to the router as a route
                 location. GoRouter then tries to match the literal
                 "https://teka.cd/<ville>/<slug>-<code>" and throws
                 `GoException: no routes for location`, landing the user on Page
                 Not Found — verified on device 2026-07-26, cold AND warm start.
                 This app routes links itself via app_links →
                 DeepLinkController → DeepLinkParser (which mirrors buyer-web
                 `lib/urls.ts` and falls back to the browser for unmappable
                 paths), so the built-in handler must be disabled or the two
                 compete and the built-in wins. See docs/deep-linking.md. -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Android App Links (verified): https://${appLinkHost}/... opens
                 the app directly. autoVerify checks
                 https://${appLinkHost}/.well-known/assetlinks.json against the
                 app's signing cert. Host is per-flavor (prod=teka.cd) via the
                 appLinkHost manifest placeholder. Unmatched/unmappable paths
                 fall back to the browser in DeepLinkController. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="${appLinkHost}"/>
                <data android:scheme="http"/>
            </intent-filter>

            <!-- Custom-scheme fallback (not auto-verified): teka://... — useful
                 for contexts that don't honour App Links. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="teka"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- FCM default channel — used by `firebase_messaging` when a
             remote notification arrives and the payload doesn't name a
             specific channel. The channel ID is created at runtime by
             flutter_local_notifications (see PushService.init()); the
             two values must match. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="teka_orders"/>
        <!-- Notification icon used when the payload doesn't carry one.
             Must be a white-on-transparent drawable for Android 5+. We
             reuse the launcher icon here as a placeholder — replace
             with a proper monochrome notification asset before launch. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher"/>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
